# Copy to .env and edit.
PORT=3000
NODE_ENV=development
# REQUIRED in production: a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-in-production
DB_FILE=./data/kca_lab.db

# Business rules
MAX_ACTIVE_RESERVATIONS=3
MAX_ADVANCE_DAYS=30
CHECKOUT_EARLY_MINUTES=15

# Optional e-mail notifications through Resend (free tier). Leave blank to use in-app notifications only.
RESEND_API_KEY=
MAIL_FROM=KCA Labs <onboarding@resend.dev>
